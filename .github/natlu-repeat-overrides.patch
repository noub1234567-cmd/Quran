+  Future<void> _waitForPlayback(int token) async {
+    final app = AppState.instance;
+    // Wait for audio to begin, allowing for network buffering.
+    final startedDeadline = DateTime.now().add(const Duration(seconds: 35));
+    while (token == _runToken && DateTime.now().isBefore(startedDeadline)) {
+      if (app.isAudioPlaying.value && !app.isAudioBuffering.value) break;
+      await Future.delayed(const Duration(milliseconds: 100));
+    }
+    if (token != _runToken) return;
+    if (!app.isAudioPlaying.value) throw TimeoutException('تعذر بدء تشغيل الآية');
+    final endDeadline = DateTime.now().add(const Duration(seconds: 90));
+    while (token == _runToken && DateTime.now().isBefore(endDeadline)) {
+      if (!app.isAudioPlaying.value && !app.isAudioBuffering.value) return;
+      await Future.delayed(const Duration(milliseconds: 120));
+    }
+  }
+
+  Future<void> _start() async {
+    if (running) return;
+    if (fromAyah > toAyah) { _toast('آية البداية يجب ألا تتجاوز آية النهاية'); return; }
+    final token = ++_runToken;
+    setState(() { running = true; paused = false; });
+    AppState.instance.stopVerseAudio();
+    if (timerMinutes > 0) {
+      _stopTimer?.cancel();
+      _stopTimer = Timer(Duration(minutes: timerMinutes), _stop);
+    }
+    try {
+      for (int round = 0; round < repeats && token == _runToken; round++) {
+        for (int target = fromAyah; target <= toAyah && token == _runToken; target++) {
+          // Cumulative mode replays the growing prefix: A; A-B; A-B-C; ...
+          final int end = cumulative ? target : toAyah;
+          for (int ayah = fromAyah; ayah <= end && token == _runToken; ayah++) {
+            setState(() => currentAyah = ayah);
+            await QuranAudioService.instance.setPlaybackSpeed(speeds[speedIndex]);
+            await QuranAudioService.instance.play(surah: surah, ayah: ayah, continuous: false);
+            await _waitForPlayback(token);
+            if (gapSeconds > 0 && token == _runToken) await Future.delayed(Duration(seconds: gapSeconds));
+          }
+          if (!cumulative) break;
+        }
+      }
+    } catch (e) {
+      if (token == _runToken && mounted) _toast('تعذر إكمال التشغيل. تحقق من اتصال الإنترنت.');
+    } finally {
+      if (token == _runToken && mounted) {
+        AppState.instance.stopVerseAudio();
+        setState(() { running = false; paused = false; });
+      }
+    }
+  }
+
+  void _stop() {
+    _runToken++;
+    _stopTimer?.cancel();
+    AppState.instance.stopVerseAudio();
+    if (mounted) setState(() { running = false; paused = false; });
+  }
